NODE_ENV=development
PORT=3001
TRUST_PROXY=1
# Same value as LIEGE_PROXY_SECRET on the www, staking and superagents Vercel projects (32+ chars).
LIEGE_PROXY_SECRET=
DATABASE_URL=
DATABASE_PASSWORD=
RHC_ID=4663
RHC_RPC_URL=
ESCROW_MODE=ledger
# V1 factory stays configured for existing jobs. New job escrows use the V2 factory.
VEILORA_ESCROW_FACTORY_ADDRESS=0x5e091ec36B3CBcA0Be42F88881FaeB3A5658C6c1
VEILORA_ESCROW_FACTORY_V2_ADDRESS=0x81E05B0Ee0229ac62ED4e3bc9242aa0b9Ac0830E
# Configure the Liege threshold signer in the backend deployment before enabling Veilora escrow.
LIEGE_ESCROW_SIGNER_ADDRESS=
LIEGE_ESCROW_SIGNER_PRIVATE_KEY=
USDG_TOKEN_ADDRESS=
USDG_DECIMALS=6
USDG_TOKEN_NAME=Global Dollar
USDG_TOKEN_VERSION=1
X402_FACILITATOR_URL=
X402_MAX_TIMEOUT_SECONDS=300
# Super Agents / X integration. X bot actions always become dashboard proposals first.
X_BOT_ENABLED=false
X_BOT_HANDLE=LiegeAgentsBot
X_ACCESS_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=
X_OAUTH_REDIRECT_URI=https://api.example.com/v1/super-agents/auth/x/callback
X_BOT_MENTIONS_POLL_INTERVAL_MS=30000
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
SUPERAGENTS_URL=https://superagents.example.com
LIEGE_TOKEN_ADDRESS=0xc32ab2e562ade6fba6d3d1e3960d49b0957ef645
LIEGE_DECIMALS=18
# Fixed-term LIEGE staking. The pool signer key is custodial and must match this address.
LIEGE_STAKING_POOL_ADDRESS=
LIEGE_STAKING_POOL_PRIVATE_KEY=
LIEGE_STAKING_ENABLED=false
LIEGE_STAKING_CONFIRMATIONS=2
ESCROW_GAS_RESERVE_USD=1
ESCROW_QUOTE_TTL_SECONDS=300
ESCROW_CONFIRMATIONS=1
AUTH_DOMAIN=api.example.com
AUTH_URI=https://app.example.com
MAX_ADMIN_CREDIT_USDG=10000
MAX_ADMIN_CREDIT_DAILY_USDG=50000
SELF_SETTLEMENT_LIMIT_LIEGE=50
AUTH_TOKEN_PEPPER=
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_PREVIOUS=
CRON_SECRET=
# Must exactly match the MCP Render service; use a unique `openssl rand -hex 32` value.
MCP_INTERNAL_API_TOKEN=
# Public Render URL for the runner service.
RUNNER_WORKER_URL=https://liegeagentsapp-runner-6mak.onrender.com
RUNNER_WORKER_TOKEN=
# Optional Virtuals ACP provider adapter. Keep this identity enabled in only one service.
ACP_ENABLED=false
ACP_CHAIN_ID=4663
ACP_EVM_WALLET_ID=
ACP_AGENT_WALLET_ADDRESS=
ACP_SIGNER_PRIVATE_KEY=
ACP_BUILDER_CODE=
ACP_DEFAULT_PRICE_USD=0.01
ADMIN_WALLET_ADDRESSES=0xyour_admin_wallet_address
# Password used to issue short-lived admin metrics sessions. Keep this server-side only.
MASTER_ADMIN_CODE=
# Resend API key for admin-sent mail from the verified Liege domain.
RESEND_API_KEY=

# Public API origin shown in GitHub trigger setup (webhook payload URL).
PUBLIC_API_URL=https://api.liegeagents.com
