{
  "name": "@liege/api",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2",
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_ENV=test bun test",
    "migrate": "bun src/db/migrate.ts",
    "reencrypt": "bun src/db/reencrypt.ts"
  },
  "dependencies": {
    "@virtuals-protocol/acp-node-v2": "^0.1.11",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "ipaddr.js": "1.9.1",
    "pg": "^8.16.3",
    "viem": "2.37.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "bun-types": "^1.4.2",
    "prettier": "3.9.6",
    "supertest": "^7.1.4",
    "typescript": "^5.8.3"
  }
}
