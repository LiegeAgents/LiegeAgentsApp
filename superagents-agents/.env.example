LIEGE_API_URL=https://api.liegeagents.com
LIEGE_RUNTIME_TOKEN=replace-with-a-scoped-runtime-token
# Public Render URL for this Super Agents runtime service.
AGENT_SERVER_URL=https://liegeagentsapp-superagents-agents-c6oo.onrender.com
PORT=3210
GROQ_API_KEY=replace-with-groq-key
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_MS=30000
GROQ_MAX_TOKENS=4000
# Attachments: the vision model reads attached images; a read-only GitHub token avoids the
# anonymous rate limit when reading linked repositories.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GITHUB_TOKEN=
ATTACHMENT_CHAR_BUDGET=24000
# Marcus publishes fixes from this bot account's fork (public_repo scope). Leave empty to review only.
MARCUS_GITHUB_TOKEN=
SCOTT_AGENT_ID=
ANNA_AGENT_ID=
MARCUS_AGENT_ID=
CHLOE_AGENT_ID=
DANIEL_AGENT_ID=
SCOTT_WEBHOOK_SECRET=
ANNA_WEBHOOK_SECRET=
MARCUS_WEBHOOK_SECRET=
CHLOE_WEBHOOK_SECRET=
DANIEL_WEBHOOK_SECRET=
# Kori is optional: set both values once the agent exists in Liege, or leave both empty.
KORI_AGENT_ID=
KORI_WEBHOOK_SECRET=
# Constantine (rug checks) is optional: set both values once the agent exists in Liege.
CONSTANTINE_AGENT_ID=
CONSTANTINE_WEBHOOK_SECRET=
# Constantine confirms Robinhood Chain contracts through this RPC.
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
