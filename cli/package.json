{
  "name": "@liege/cli",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2",
    "node": ">=22 <25"
  },
  "bin": {
    "liege": "src/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "compile": "bun build --compile src/index.ts --outfile liege",
    "package:smoke": "sh package-smoke.sh"
  },
  "devDependencies": {
    "bun-types": "1.4.2",
    "typescript": "5.8.3"
  }
}
